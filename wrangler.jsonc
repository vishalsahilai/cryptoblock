{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cryptoblock",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cryptoblock-db",
      "database_id": "d923e51e-c63a-46aa-b9e6-ae371b52b04e",
      "migrations_dir": "drizzle"
    }
  ],
  "triggers": {
    "crons": [
      "10 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
